# WebAdminPanel Environment Variables
# Copy this file to .env and adjust values for your environment.

# Base URL for the Backend API (must include /api/v1 for this project)
REACT_APP_API_BASE=http://localhost:3001/api/v1

# OAuth2 Authorization Code Flow endpoints
REACT_APP_OAUTH_AUTH_URL=http://localhost:3001/oauth/authorize
REACT_APP_OAUTH_TOKEN_URL=http://localhost:3001/oauth/token

# OAuth2 Client configuration
REACT_APP_OAUTH_CLIENT_ID=admin-web

# The URL in the browser where the app is served. For local dev CRA defaults to 3000.
# Make sure your backend OAuth app has this redirect URI registered.
REACT_APP_OAUTH_REDIRECT_URI=http://localhost:3000

# Space-separated scopes requested during auth
REACT_APP_OAUTH_SCOPES=admin
