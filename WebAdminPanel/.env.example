# API Configuration
# Base URL for the backend API
REACT_APP_API_BASE_URL=https://api.uppuvelibeach.com/api/v1

# OAuth2 Configuration
# Authorization endpoint for OAuth2 flow
REACT_APP_OAUTH_AUTHORIZATION_URL=https://api.uppuvelibeach.com/oauth/authorize

# Token endpoint for OAuth2 flow
REACT_APP_OAUTH_TOKEN_URL=https://api.uppuvelibeach.com/oauth/token

# OAuth2 Client ID (REQUIRED - request from administrator)
REACT_APP_OAUTH_CLIENT_ID=your_client_id_here

# OAuth2 Redirect URI (callback URL after authentication)
REACT_APP_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# Site URL for the application
REACT_APP_SITE_URL=http://localhost:3000

# Note: For production deployment, update all URLs to production endpoints
# and ensure REACT_APP_OAUTH_CLIENT_ID is properly configured
