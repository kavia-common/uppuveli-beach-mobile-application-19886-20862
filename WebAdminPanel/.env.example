# API Configuration
REACT_APP_API_BASE_URL=https://api.uppuvelibeach.com/api/v1

# OAuth2 Configuration
# IMPORTANT: REACT_APP_OAUTH_CLIENT_ID must be requested from the user
REACT_APP_OAUTH_CLIENT_ID=your_oauth_client_id_here
REACT_APP_OAUTH_REDIRECT_URI=http://localhost:3000/login/callback
REACT_APP_OAUTH_AUTHORIZE_URL=https://api.uppuvelibeach.com/oauth/authorize
REACT_APP_OAUTH_TOKEN_URL=https://api.uppuvelibeach.com/oauth/token
